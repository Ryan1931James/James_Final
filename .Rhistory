labs(title = "Volcano Plot: Smokers vs Non-Smokers ('normal' Shrinkage)",
x = "Log2 Fold Change (Effect Size)",
y = "-Log10 Raw P-Value") +
theme(legend.position = "bottom")
# 1. Cleanly omit samples with missing Age data
meta_clean <- na.omit(meta_df)
counts_clean <- count_matrix[, rownames(meta_clean)]
counts_clean <- round(counts_clean)
mode(counts_clean) <- "integer"
# 2. Force smoking status to be a factor and explicitly set the baseline reference
meta_clean$current_smoking_status <- factor(meta_clean$current_smoking_status,
levels = c("control", "case"))
# 3. Re-initialize your DESeq dataset structure
dds_analysis <- DESeqDataSetFromMatrix(countData = counts_clean,
colData = meta_clean,
design = ~ current_smoking_status)
# 4. Standard normalization and robust mean dispersion pipeline
dds_analysis <- estimateSizeFactors(dds_analysis)
dds_analysis <- estimateDispersions(dds_analysis, fitType = "mean")
dds_analysis <- nbinomWaldTest(dds_analysis)
# 5. Extract formal contrast results table
res <- results(dds_analysis,
contrast = c("current_smoking_status", "case", "control"),
alpha = 0.05,
pAdjustMethod = "fdr")
# 6. FIX: Apply Log2 Fold Change Shrinkage using the built-in 'normal' type
target_coef <- grep("current_smoking_status_case_vs_control", resultsNames(dds_analysis), value = TRUE)
res_shrunk  <- lfcShrink(dds_analysis,
coef = target_coef,
type = "normal") # Swapped to native 'normal' method
# Generate overall evaluation summary metrics in console
summary(res_shrunk)
# Filter out the strict statistically significant genes
sig_genes_df <- as.data.frame(res_shrunk)
sig_genes_df$ENTREZID <- rownames(sig_genes_df)
# Merge back with your earlier annotations
annotations <- as.data.frame(data.filtered[, c("ENTREZID", "SYMBOL", "GENENAME"), with = FALSE])
sig_genes_annotated <- merge(sig_genes_df, annotations, by = "ENTREZID")
# Filter for strict significance: FDR < 0.05 and Fold Change > 1.5x (abs(log2FC) > 0.58)
sig_final_table <- subset(sig_genes_annotated, padj < 0.05 & abs(log2FoldChange) > 0.58)
# Print top 10 most significant differentially expressed genes
head(sig_final_table[order(sig_final_table$padj), ], 10)
# Plot dispersion metrics to evaluate mathematical model fit quality
plotDispEsts(dds_analysis,
main = "Model Evaluation: Dispersion Estimates (Mean Fit)")
